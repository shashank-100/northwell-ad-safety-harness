{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northwell-ad-safety",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/demo", "/demo/", "/api/*"] }
}
